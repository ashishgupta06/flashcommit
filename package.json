{
  "name": "flashcommit",
  "displayName": "Flash Commit",
  "description": "Generate commit messages using claude code cli or openai compatible api",
  "version": "0.0.1",
  "license": "MIT",
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "flashcommit.generate",
        "title": "Generate Commit Message",
        "category": "Flash Commit",
        "icon": "$(zap)"
      },
      {
        "command": "flashcommit.setApiKey",
        "title": "Set OpenAI API Key",
        "category": "Flash Commit"
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "flashcommit.generate",
          "when": "scmProvider == git",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Flash Commit",
      "properties": {
        "flashcommit.provider": {
          "type": "string",
          "enum": [
            "claude",
            "openai"
          ],
          "default": "claude",
          "description": "Backend used to generate commit messages.",
          "order": 0
        },
        "flashcommit.prompt": {
          "type": "string",
          "default": "Write a concise conventional commit message for this diff. Output only the message.",
          "description": "Instruction sent along with the diff.",
          "order": 1
        },
        "flashcommit.claude.path": {
          "type": "string",
          "default": "claude",
          "description": "[Claude CLI] Path to the Claude Code CLI.",
          "order": 2
        },
        "flashcommit.claude.model": {
          "type": "string",
          "default": "haiku",
          "description": "[Claude CLI] Model passed as --model (empty = CLI default).",
          "order": 3
        },
        "flashcommit.claude.allowedTools": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "[Claude CLI] Tools Claude Code may use without prompting, passed as --allowedTools (e.g. \"Read\", \"Bash(git log:*)\"). Empty = not passed.",
          "order": 4
        },
        "flashcommit.claude.extraArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "[Claude CLI] Extra arguments passed to claude -p.",
          "order": 5
        },
        "flashcommit.openai.baseUrl": {
          "type": "string",
          "default": "https://api.openai.com/v1",
          "description": "[OpenAI-compatible] OpenAI-compatible base URL (e.g. http://localhost:11434/v1 for Ollama).",
          "order": 6
        },
        "flashcommit.openai.model": {
          "type": "string",
          "default": "gpt-4o-mini",
          "description": "[OpenAI-compatible] Model name for the OpenAI-compatible endpoint.",
          "order": 7
        },
        "flashcommit.timeoutSeconds": {
          "type": "number",
          "default": 60,
          "description": "Generation timeout in seconds.",
          "order": 8
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run package",
    "compile": "pnpm run check-types && pnpm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "pnpm run check-types && pnpm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "pnpm run compile-tests && pnpm run compile && pnpm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.140.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "esbuild": "^0.28.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "extensionDependencies": [
    "vscode.git"
  ]
}
